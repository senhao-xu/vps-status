# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM golang:1.24.9-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags "-s -w -buildid= -X github.com/senhao-xu/vps-status/internal/versioninfo.Version=${VERSION} -X github.com/senhao-xu/vps-status/internal/versioninfo.Commit=${COMMIT}" \
    -o /out/vps-status-agent ./cmd/agent && mkdir -p /out/data && chmod 0700 /out/data

FROM gcr.io/distroless/static-debian12:nonroot
ARG VERSION=dev
ARG COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/senhao-xu/vps-status" \
      org.opencontainers.image.title="VPS Status Agent" \
      org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.revision=${COMMIT}
COPY --from=build /out/vps-status-agent /vps-status-agent
COPY --from=build --chown=nonroot:nonroot --chmod=0700 /out/data /data
VOLUME ["/data"]
USER nonroot:nonroot
ENTRYPOINT ["/vps-status-agent"]
CMD ["--config", "/data/agent.json", "--proc-root", "/host/proc", "--sys-root", "/host/sys", "--rootfs", "/host/root", "--os-release", "/host/os-release"]
